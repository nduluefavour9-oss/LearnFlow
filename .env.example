NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:YOUR_DATABASE_PASSWORD@db.your-project.supabase.co:5432/postgres
DATABASE_SSL=true
DATABASE_SSL_CA_FILE=.local/prod-ca-2021.crt
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-public-anon-key
DATABASE_POOL_SIZE=10
