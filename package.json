{
  "name": "learnflow",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "web",
    "server"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm run dev -w @learnflow/server\" \"npm run dev -w @learnflow/web\"",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start -w @learnflow/server",
    "db:seed": "npm run db:seed -w @learnflow/server",
    "check": "npm run check --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
